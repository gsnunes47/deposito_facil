generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
}

model Tenants {
  id Int @id @default(autoincrement())
  name String @unique
  created_at DateTime @default(now())
  users User[]
}

model User {
  id Int @id @default(autoincrement())
  created_at DateTime @default(now())
  name String
  password String
  access_level String
  tenant_id Int
  tenant Tenants @relation(fields: [tenant_id], references: [id])
}

model Despesa {
  id Int @id @default(autoincrement())
  tenant_id Int
  descricao String
  valor Int 
}

model Produto {
  id Int @id @default(autoincrement())
  tenant_id Int
  nome String
  quantidade Int? @default(0)
}

model Cliente {
  id Int @id @default(autoincrement())
  tenant_id Int
  nome String?
  documento String? @default("")
  vendas Venda[]
}

model Venda {
  id Int @id @default(autoincrement())
  tenant_id Int
  cliente_id Int
  produtos Json @db.Json
  total Int //centavos
  data DateTime @default(now())
  data_quitacao DateTime?
  pago Boolean @default(false)
  pagamentos Pagamento[]
  cliente Cliente @relation(fields: [cliente_id], references: [id])
  // produtos deve ser um array de transações:
  // [{ produto: "banana prata", quantidade: 10, preco: 50000 }, ...]
}

model Pagamento {
  id Int @id @default(autoincrement())
  tenant_id Int
  venda_id Int
  valor Int? @default(1) //centavos
  data_pagamento DateTime @default(now())
  forma_pagamento FormaPagamento
  venda Venda @relation(fields: [venda_id], references: [id])
}

model Fornecedor {
  id Int @id @default(autoincrement())
  tenant_id Int
  nome String?
  documento String? @default("")
  encomendas Encomenda[]
}

model Encomenda {
  id Int @id @default(autoincrement())
  tenant_id Int
  fornecedor_id Int
  produtos Json @db.Json
  total Int //centavos
  data DateTime @default(now())
  data_quitacao DateTime?
  pago Boolean @default(false)
  pagamentos PagamentoEncomenda[]
  fornecedor Fornecedor @relation(fields: [fornecedor_id], references: [id])
  // produtos deve ser um array de transações:
  // [{ produto: "banana prata", quantidade: 10, preco: 50000 }, ...]
}

model PagamentoEncomenda {
  id Int @id @default(autoincrement())
  tenant_id Int
  encomenda_id Int
  valor Int? @default(1) //centavos
  data_pagamento DateTime @default(now())
  forma_pagamento FormaPagamento
  encomenda Encomenda @relation(fields: [encomenda_id], references: [id])
}
