generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenants {
  id Int @id @default(autoincrement())
  name String @unique
  created_at DateTime @default(now())
  users User[]
}

model User {
  id Int @id @default(autoincrement())
  created_at DateTime @default(now())
  name String @unique
  password String
  access_level String
  tenant_id Int
  tenant Tenants @relation(fields: [tenant_id], references: [id])
}

model Produto {
  id Int @id @default(autoincrement())
  nome String
  quantidade Int? @default(0)
  tenant_id Int
}

model Cliente {
  id Int @id @default(autoincrement())
  nome String?
  documento String? @default("")
  tenant_id Int
}

