{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc --build",
    "start": "node ./build/index.js",
    "dev": "npm run services:up && npm run migrate && npm run seeder && nodemon --watch src --exec tsx -r dotenv/config src/index.ts",
    "services:up": "docker compose -f ./infra/compose.yaml up -d",
    "services:stop": "docker compose -f ./infra/compose.yaml stop",
    "services:down": "docker compose -f ./infra/compose.yaml down",
    "migrate": "npx prisma migrate dev",
    "seeder": "npx tsx seeders/basic.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.2",
    "dotenv": "^17.3.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
